# ==============================================================================
# LINTAS AI GATEWAY - ENVIRONMENT CONFIG TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan dengan lingkungan server / VPS Anda:
#   cp .env.example .env
# ==============================================================================

# [1] Database Connection (PostgreSQL - Prisma ORM)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://lintas:password_rahasia@localhost:5432/lintas_ai_gateway?schema=public"

# [2] Keamanan & Admin Dashboard
# JWT_SECRET: Kunci enkripsi token sesi login dashboard (wajib diganti dengan string acak panjang di production)
JWT_SECRET=lintas-ai-change-this-to-a-long-random-secret-string
# INITIAL_PASSWORD: Password default awal untuk login pertama kali ke dashboard admin
INITIAL_PASSWORD=admin-password-dashboard
# AUTH_COOKIE_SECURE: Set 'true' jika server berjalan di HTTPS/SSL, atau 'false' jika HTTP / IP lokal
AUTH_COOKIE_SECURE=false

# [3] Direktori Data Lokal
# Folder penyimpanan data runtime lokal (cache token-saver, machine-id, sertifikat MITM, log buffer)
# Pastikan direktori ini memiliki izin baca & tulis (read-write) oleh user aplikasi
DATA_DIR=./data

# [4] Server Runtime
PORT=20127
HOSTNAME=0.0.0.0
NODE_ENV=production

# [5] Konfigurasi Domain / URL Gateway
# URL dasar yang digunakan dashboard & callback (sesuaikan dengan domain/IP publik server Anda)
BASE_URL=http://localhost:20127
NEXT_PUBLIC_BASE_URL=http://localhost:20127

# [6] Pengamanan Endpoint AI Gateway
# Set 'true' untuk mewajibkan header 'Authorization: Bearer <API_KEY>' pada setiap panggilan ke /v1/*
# Set 'false' jika gateway berada di private network dan belum ingin mewajibkan API key
REQUIRE_API_KEY=false
