# ==========================================
# LINTAS AI GATEWAY - ENVIRONMENT CONFIG
# ==========================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lintas_ai_gateway?schema=public"

# Keamanan & Admin Dashboard
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=./data

# Server Runtime
PORT=20127
HOSTNAME=0.0.0.0
NODE_ENV=production

# Konfigurasi URL Gateway
BASE_URL=http://localhost:20127
NEXT_PUBLIC_BASE_URL=http://localhost:20127

# Opsional: Keamanan Tambahan
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
